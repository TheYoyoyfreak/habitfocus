{
  "manifest_version": 3,
  "name": "habitfocus",
  "version": "0.1.0",
  "description": "Blocks distracting sites until you finish your habits. Needs the habitfocus daemon (hf install-native-host).",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "webNavigation", "storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "habitfocus@habitfocus.dev",
      "strict_min_version": "121.0",
      "update_url": "https://github.com/TheYoyoyfreak/habitfocus/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
